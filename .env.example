# RecoverAI Environment Configuration
# =====================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# NEVER hardcode secrets in source code.

# ------------------------------------
# App
# ------------------------------------
APP_NAME=RecoverAI
APP_VERSION=1.0.0
DEBUG=false

# ------------------------------------
# Database
# ------------------------------------
DATABASE_URL=sqlite:///./recoverai.db

# ------------------------------------
# NVIDIA NIM — AI Provider
# ------------------------------------
# Get your key at: https://build.nvidia.com
# Variable name: NGC_API_KEY (do NOT rename)
NGC_API_KEY=your_ngc_api_key_here

NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

# NIM retry configuration
NIM_MAX_RETRIES=3
NIM_BASE_DELAY=1.0
NIM_MAX_DELAY=30.0

# ------------------------------------
# Razorpay (Test Mode Only)
# ------------------------------------
# Use test-mode keys ONLY for development
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# ------------------------------------
# API Security
# ------------------------------------
# Change this in production — minimum 32 chars
INTERNAL_API_KEY=change-this-to-a-secure-random-string-in-production

# ------------------------------------
# CORS
# ------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------
# Rate Limiting
# ------------------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEALTH=100/minute
